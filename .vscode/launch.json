{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "VIORA (Flutter Web - Chrome)",
      "request": "launch",
      "type": "dart",
      "program": "lib/main.dart",
      "args": [
        "-d",
        "chrome",
        "--web-renderer",
        "canvaskit"
      ]
    },
    {
      "name": "VIORA (Flutter Web - Edge)",
      "request": "launch",
      "type": "dart",
      "program": "lib/main.dart",
      "args": [
        "-d",
        "edge"
      ]
    },
    {
      "name": "VIORA (Flutter Web Server)",
      "request": "launch",
      "type": "dart",
      "program": "lib/main.dart",
      "args": [
        "-d",
        "web-server",
        "--web-port",
        "8080",
        "--web-hostname",
        "0.0.0.0"
      ]
    },
    {
      "name": "VIORA (Mobile Emulator / Device)",
      "request": "launch",
      "type": "dart",
      "program": "lib/main.dart"
    }
  ]
}
